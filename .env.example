# Database
DATABASE_URL=postgresql://user:password@localhost:5432/thrinxs
DIRECT_URL=postgresql://user:password@localhost:5432/thrinxs

# Auth
AUTH_SECRET=your-auth-secret-here
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage
S3_BUCKET_NAME=thrinxs-media
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_ENDPOINT=your-endpoint

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Paystack
PAYSTACK_SECRET_KEY=your-paystack-secret
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your-paystack-public-key

# Email
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@thrinxs.com.ng

# Redis
UPSTASH_REDIS_URL=your-redis-url
UPSTASH_REDIS_TOKEN=your-redis-token

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CMS_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_DOCS_URL=http://localhost:3003
NEXT_PUBLIC_ADMIN_URL=http://localhost:3004

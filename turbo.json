{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"],
      "env": ["RESEND_API_KEY", "NEXT_PUBLIC_SUPABASE_URL", "NEXT_PUBLIC_SUPABASE_ANON_KEY", "JWT_SECRET"]
    },
    "dev": {
      "cache":      false,
      "persistent": true
    },
    "lint":       { "dependsOn": ["^build"] },
    "format":     { "cache": false },
    "db:generate":{ "cache": false },
    "db:push":    { "cache": false },
    "db:migrate": { "cache": false },
    "db:studio":  { "cache": false, "persistent": true }
  }
}

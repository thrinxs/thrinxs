{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs":   [".next/**", "dist/**"]
    },
    "dev": {
      "cache":      false,
      "persistent": true
    },
    "lint":       { "dependsOn": ["^build"] },
    "format":     { "cache": false },
    "db:generate":{ "cache": false },
    "db:push":    { "cache": false },
    "db:migrate": { "cache": false },
    "db:studio":  { "cache": false, "persistent": true }
  }
}
